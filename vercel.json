{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/siliguri-durga-puja-guide",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/siliguri-puja",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/best-puja-pandals-in-siliguri",
      "destination": "/siliguri-puja-pandals",
      "permanent": true
    },
    {
      "source": "/pandal-hopping-in-siliguri",
      "destination": "/siliguri-puja-routes",
      "permanent": true
    },
    {
      "source": "/puja-schedule/2026",
      "destination": "/puja-schedule",
      "permanent": true
    },
    {
      "source": "/mahalaya/2026",
      "destination": "/mahalaya",
      "permanent": true
    },
    {
      "source": "/guides",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/guides/best-durga-puja-pandals-in-siliguri",
      "destination": "/blog/best-theme-pandals-durga-puja-pandal-map-2026",
      "permanent": true
    },
    {
      "source": "/guides/central-colony-durga-puja-2026",
      "destination": "/blog/durga-puja-pandal-map-2026-near-njp-siliguri-junction",
      "permanent": true
    },
    {
      "source": "/guides/mahalaya-siliguri-traditions",
      "destination": "/mahalaya",
      "permanent": true
    },
    {
      "source": "/guides/siliguri-pandal-hopping-guide",
      "destination": "/blog/durga-puja-pandal-map-2026-walking-routes",
      "permanent": true
    },
    {
      "source": "/guides/siliguri-puja-map-guide",
      "destination": "/blog/durga-puja-pandal-map-2026",
      "permanent": true
    },
    {
      "source": "/guides/:slug*",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), payment=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(favicon.ico|icon.svg|icon-192.png|icon-512.png|apple-touch-icon.png|logo-icon.webp|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|feed.xml|llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
